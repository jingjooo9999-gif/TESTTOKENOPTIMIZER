{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start TokenGuard Proxy",
      "type": "shell",
      "command": "npm start",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "LOCAL AI TOKEN OPTIMIZER",
          "endsPattern": "Live Dashboard listening"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
